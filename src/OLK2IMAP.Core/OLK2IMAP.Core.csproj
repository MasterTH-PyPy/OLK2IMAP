<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>OLK2IMAP.Core</RootNamespace>
    <AssemblyName>OLK2IMAP.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- MIME + IMAP. 4.16.0 fixes GHSA-9j88-vvj5-vhgr (CVE-2026-41319). -->
    <PackageReference Include="MimeKit" Version="4.16.0" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <!-- override vulnerable transitive Pkcs; 9.0.21 fixes GHSA-846f-f764-76mx -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
    <!-- Exchange Web Services (community .NET port of the EWS Managed API) -->
    <PackageReference Include="Microsoft.Exchange.WebServices.NETStandard" Version="1.0.4" />
    <!-- PST writing without Outlook (commercial; license required for production) -->
    <PackageReference Include="Aspose.Email" Version="24.10.0" />
  </ItemGroup>

</Project>
